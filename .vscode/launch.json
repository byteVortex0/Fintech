    "version": "0.2.0",
    "configurations": [
        {
            "name": "fintech dev",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor", //flavor name
                "dev",
                "-t", // if your have different main file
                "lib/main_dev.dart"
            ]
        },
        {
            "name": "fintech prod",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--flavor", //flavor name
                "prod",
                "-t", // if your have different main file
                "lib/main_prod.dart"
            ]
        }
    ]
}